<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/playlist_card_width"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/card_spacing"
    android:layout_marginVertical="6dp"
    android:focusable="true"
    android:clickable="true"
    android:foreground="@drawable/card_selector"
    android:stateListAnimator="@animator/focus_zoom">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_content"
        android:clipToOutline="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/playlist_cover_height">

            <ImageView
                android:id="@+id/iv_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@color/black"
                android:contentDescription="播放列表封面"
                android:focusable="false" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/card_gradient_overlay" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tv_playlist_name"
                style="@style/TvText.CardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="播放列表名称"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="start"
                android:focusable="false" />

            <TextView
                android:id="@+id/tv_stats"
                style="@style/TvText.CardMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="120个文件"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:focusable="false" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/iv_delete"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:background="@drawable/circle_background"
        android:padding="7dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="删除播放列表" />

    <ImageView
        android:id="@+id/iv_refresh"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:src="@android:drawable/ic_popup_sync"
        android:background="@drawable/circle_background"
        android:padding="10dp"
        android:visibility="gone"
        android:clickable="false"
        android:focusable="false"
        android:contentDescription="长按卡片刷新播放列表" />

    <!-- 同步中的转圈进度（与刷新图标同位置互换显示） -->
    <ProgressBar
        android:id="@+id/progress_refresh"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center"
        android:visibility="gone" />

</FrameLayout>
