<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="168dp"
    android:layout_margin="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/card_selector"
    android:stateListAnimator="@animator/focus_zoom">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_card_content"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/iv_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black"
            android:contentDescription="@string/playlist_cover"
            android:focusable="false"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/card_gradient_overlay" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tv_playlist_name"
                style="@style/TvText.CardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tv_stats"
                style="@style/TvText.CardMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>
    </FrameLayout>

    <ImageView
        android:id="@+id/iv_delete"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:background="@drawable/circle_background"
        android:clickable="true"
        android:contentDescription="@string/playlist_action_delete"
        android:focusable="true"
        android:padding="7dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/iv_refresh"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:background="@drawable/circle_background"
        android:clickable="false"
        android:contentDescription="@string/playlist_refresh_hint"
        android:focusable="false"
        android:padding="10dp"
        android:src="@android:drawable/ic_popup_sync"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progress_refresh"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center"
        android:visibility="gone" />
</FrameLayout>
