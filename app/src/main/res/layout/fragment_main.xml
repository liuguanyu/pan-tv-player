<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient">

    <!-- 顶部品牌区 -->
    <LinearLayout
        android:id="@+id/ll_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_screen"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="@id/ll_top_actions"
        app:layout_constraintBottom_toBottomOf="@id/ll_top_actions"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="@dimen/brand_logo_size"
            android:layout_height="@dimen/brand_logo_size"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/app_name"
            android:focusable="false" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:focusable="false" />
    </LinearLayout>

    <!-- 顶部操作栏（带文字标签，语义明确） -->
    <LinearLayout
        android:id="@+id/ll_top_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="@dimen/spacing_screen"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/btn_browse_files"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginEnd="@dimen/spacing_lg"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="24dp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/action_button_selector"
            android:stateListAnimator="@animator/focus_zoom">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_browse_folder"
                android:contentDescription="@string/action_browse"
                android:focusable="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_browse"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:focusable="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_create_playlist"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginEnd="@dimen/spacing_lg"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="24dp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/action_button_selector"
            android:stateListAnimator="@animator/focus_zoom">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_add_playlist"
                android:contentDescription="@string/action_create"
                android:focusable="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_create"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:focusable="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_settings"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="24dp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/action_button_selector"
            android:stateListAnimator="@animator/focus_zoom">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_settings_gear"
                android:contentDescription="@string/action_settings"
                android:focusable="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_settings"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:focusable="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- 播放列表区标题 -->
    <LinearLayout
        android:id="@+id/ll_playlist_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_screen"
        android:layout_marginTop="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/ll_top_actions"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="5dp"
            android:layout_height="30dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_section_accent" />

        <TextView
            android:id="@+id/tv_playlist_title"
            style="@style/TvText.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/my_playlists" />
    </LinearLayout>

    <!-- 播放列表内容 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_playlists"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xl"
        android:clipToPadding="false"
        android:paddingStart="@dimen/spacing_screen"
        android:paddingEnd="@dimen/spacing_screen"
        android:focusable="false"
        android:descendantFocusability="afterDescendants"
        app:layout_constraintTop_toBottomOf="@id/ll_playlist_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 播放列表空状态 -->
    <LinearLayout
        android:id="@+id/empty_playlist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xl"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_lg"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/ll_playlist_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/ic_empty_playlist"
            android:contentDescription="@string/empty_playlist_title" />

        <TextView
            style="@style/TvText.EmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/empty_playlist_title" />

        <TextView
            style="@style/TvText.EmptySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/empty_playlist_subtitle" />

        <LinearLayout
            android:id="@+id/btn_empty_create"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/spacing_xl"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="24dp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/action_button_selector"
            android:stateListAnimator="@animator/focus_zoom">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_add_playlist"
                android:contentDescription="@string/action_create"
                android:focusable="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_create"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:focusable="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- 播放列表区底部屏障：列表与空状态谁高取谁，避免空态时与下方区块重叠 -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_playlist_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="rv_playlists,empty_playlist" />

    <!-- 最近播放区标题 -->
    <LinearLayout
        android:id="@+id/ll_recent_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_screen"
        android:layout_marginTop="@dimen/spacing_screen"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/barrier_playlist_bottom"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="5dp"
            android:layout_height="30dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_section_accent" />

        <TextView
            android:id="@+id/tv_recent_title"
            style="@style/TvText.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recent_tasks" />
    </LinearLayout>

    <!-- 最近播放内容 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_recent_tasks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xl"
        android:clipToPadding="false"
        android:paddingStart="@dimen/spacing_screen"
        android:paddingEnd="@dimen/spacing_screen"
        android:focusable="false"
        android:descendantFocusability="afterDescendants"
        app:layout_constraintTop_toBottomOf="@id/ll_recent_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 最近播放空状态 -->
    <LinearLayout
        android:id="@+id/empty_recent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/spacing_screen"
        android:paddingEnd="@dimen/spacing_screen"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/ll_recent_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="20dp"
            android:src="@drawable/ic_empty_recent"
            android:contentDescription="@string/empty_recent_title" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/TvText.EmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empty_recent_title" />

            <TextView
                style="@style/TvText.EmptySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/empty_recent_subtitle" />
        </LinearLayout>
    </LinearLayout>

    <!-- 底部操作提示条 -->
    <TextView
        android:id="@+id/tv_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_screen"
        android:layout_marginBottom="16dp"
        android:text="@string/hint_default"
        android:textSize="13sp"
        android:textColor="@color/text_tertiary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
