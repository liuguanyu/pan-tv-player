<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_screen"
    android:paddingEnd="@dimen/spacing_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:clipChildren="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/app_name"
            android:focusable="false"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_browse_files"
            style="@style/HomeTopAction"
            android:drawableStart="@drawable/ic_browse_folder"
            android:text="@string/action_browse" />

        <TextView
            android:id="@+id/btn_create_playlist"
            style="@style/HomeTopAction"
            android:layout_marginStart="12dp"
            android:drawableStart="@drawable/ic_add_playlist"
            android:text="@string/action_create" />

        <TextView
            android:id="@+id/btn_settings"
            style="@style/HomeTopAction"
            android:layout_marginStart="12dp"
            android:drawableStart="@drawable/ic_settings_gear"
            android:text="@string/action_settings" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/home_tabs"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:clipChildren="false"
        android:gravity="start|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tab_playlists"
            style="@style/HomeTab"
            android:text="@string/my_playlists" />

        <TextView
            android:id="@+id/tab_recent"
            style="@style/HomeTab"
            android:layout_marginStart="10dp"
            android:text="@string/recent_tasks" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/home_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_playlists"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:focusable="false"
            android:paddingTop="8dp"
            android:paddingBottom="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_recent_tasks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:focusable="false"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/empty_playlist"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:contentDescription="@string/empty_playlist_title"
                android:src="@drawable/ic_empty_playlist" />

            <TextView
                style="@style/TvText.EmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/empty_playlist_title" />

            <TextView
                style="@style/TvText.EmptySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/empty_playlist_subtitle" />

            <TextView
                android:id="@+id/btn_empty_create"
                style="@style/HomeTopAction"
                android:layout_marginTop="16dp"
                android:drawableStart="@drawable/ic_add_playlist"
                android:text="@string/action_create" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/empty_recent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:contentDescription="@string/empty_recent_title"
                android:src="@drawable/ic_empty_recent" />

            <TextView
                style="@style/TvText.EmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/empty_recent_title" />

            <TextView
                style="@style/TvText.EmptySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/empty_recent_subtitle" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/tv_hint"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:text="@string/hint_default"
        android:textColor="@color/text_tertiary"
        android:textSize="13sp" />
</LinearLayout>
