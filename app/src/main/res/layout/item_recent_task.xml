<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/recent_card_width"
    android:layout_height="@dimen/recent_card_height"
    android:layout_marginEnd="@dimen/card_spacing"
    android:layout_marginVertical="6dp"
    android:focusable="true"
    android:clickable="true"
    android:foreground="@drawable/card_selector"
    android:stateListAnimator="@animator/focus_zoom">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_card_content"
        android:clipToOutline="true">

    <ImageView
        android:id="@+id/iv_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="#333333"
        android:contentDescription="@string/thumbnail" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/card_gradient_overlay" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="12dp"
        android:focusable="false">

        <TextView
            android:id="@+id/tv_folder_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="文件夹名称"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:maxLines="1"
            android:ellipsize="end"
            android:focusable="false" />

        <TextView
            android:id="@+id/tv_folder_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="/路径/到/文件夹"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:maxLines="1"
            android:ellipsize="middle"
            android:layout_marginTop="2dp"
            android:focusable="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:focusable="false">

            <TextView
                android:id="@+id/tv_media_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="图片"
                android:textSize="11sp"
                android:textColor="@color/white"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@drawable/bg_media_badge"
                android:focusable="false" />

            <TextView
                android:id="@+id/tv_file_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10个文件"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:layout_marginStart="8dp"
                android:layout_gravity="center_vertical"
                android:focusable="false" />

            <TextView
                android:id="@+id/tv_last_play_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3天前"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:layout_marginStart="8dp"
                android:layout_gravity="center_vertical"
                android:maxLines="1"
                android:focusable="false" />
        </LinearLayout>
    </LinearLayout>
    </FrameLayout>
</FrameLayout>
