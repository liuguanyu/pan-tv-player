<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.BaiduTVPlayer" parent="Theme.Leanback">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent</item>
    </style>

    <style name="Theme.BaiduTVPlayer.Fullscreen" parent="Theme.BaiduTVPlayer">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- ==================== 文字层级规范 ==================== -->

    <!-- 点号命名空间的空基样式（aapt2 要求隐式父样式存在） -->
    <style name="TvText" />

    <!-- 区块标题（我的播放列表 / 最近播放） -->
    <style name="TvText.SectionTitle">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- 卡片主标题 -->
    <style name="TvText.CardTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- 卡片辅助信息（文件数、路径、时间等） -->
    <style name="TvText.CardMeta">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- 空状态标题 -->
    <style name="TvText.EmptyTitle">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary_dim</item>
    </style>

    <!-- 空状态副标题 -->
    <style name="TvText.EmptySubtitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <!-- 播放页控制栏按钮：深色半透明底 + 焦点高亮，与主界面操作按钮同一语言 -->
    <style name="PlaybackControlButton">
        <item name="android:layout_width">112dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/action_button_selector</item>
        <item name="android:stateListAnimator">@animator/focus_zoom</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- 设置页：TV 友好的可聚焦行 -->
    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="android:paddingVertical">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:background">@drawable/selector_item_background</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="SettingsRowLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="SettingsRowValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFD54F</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 文件浏览页：顶部操作按钮（视觉对齐设置页可聚焦行） -->
    <style name="FileBrowserActionButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:background">@drawable/selector_item_background</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:gravity">center</item>
    </style>

</resources>
