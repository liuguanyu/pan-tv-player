<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/action_button_focused" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#4D2196F3" />
            <stroke android:width="2dp" android:color="@color/item_focused_bright" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/action_button_normal" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
