<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android TV 特性 -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".BaiduTVApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BaiduTVPlayer"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- 主 Activity (LEANBACK_LAUNCHER) -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.BaiduTVPlayer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 登录 Activity -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.BaiduTVPlayer" />

        <!-- 文件浏览 Activity -->
        <activity
            android:name=".ui.filebrowser.FileBrowserActivity"
            android:exported="false"
            android:theme="@style/Theme.BaiduTVPlayer" />

        <!-- 播放 Activity -->
        <activity
            android:name=".ui.playback.PlaybackActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize"
            android:theme="@style/Theme.BaiduTVPlayer.Fullscreen" />

        <!-- 设置 Activity -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.BaiduTVPlayer" />

        <!-- 地点提取服务（运行在独立进程，防 native 崩溃影响主进程） -->
        <service
            android:name=".service.LocationExtractionService"
            android:exported="false"
            android:process=":location_extractor" />

    </application>

</manifest>
